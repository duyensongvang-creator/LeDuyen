---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`Blog - ${SITE_TITLE}`} description="Bài viết mới nhất về AI, kinh doanh và cuộc sống." />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<section>
				<span class="pill">Blog</span>
				<h1>Bài viết mới nhất</h1>
				<p class="sub">Chia sẻ thực chiến về ứng dụng AI, kinh doanh online và cuộc sống.</p>
				<div class="posts">
					{posts.map((post) => (
						<a class="post" href={`/blog/${post.id}/`}>
							{post.data.heroImage && <div class="thumb"><img src={post.data.heroImage} alt="" loading="lazy" /></div>}
							<h3>{post.data.title}</h3>
							<p>{post.data.description}</p>
							<FormattedDate date={post.data.pubDate} />
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
		<style>
			h1 { font-size: clamp(32px, 4.5vw, 48px); letter-spacing: -1px; line-height: 1.15; margin-top: 14px; }
		</style>
	</body>
</html>
