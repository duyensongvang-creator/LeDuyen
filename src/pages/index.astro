---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const groups = [
	{ id: 'anh', icon: '🖼️', name: 'Làm ảnh', count: 10, cls: 'g1' },
	{ id: 'video', icon: '🎬', name: 'Làm video', count: 11, cls: 'g2' },
	{ id: 'viet', icon: '✍️', name: 'Viết nội dung', count: 5, cls: 'g3' },
	{ id: 'auto', icon: '⚙️', name: 'Tự động hoá', count: 2, cls: 'g4' },
];
const groupName = Object.fromEntries(groups.map((g) => [g.id, g.name]));
const total = groups.reduce((s, g) => s + g.count, 0);

const skills = [
	{ c: 'anh', t: 'Hoán đổi nhân vật', d: 'Đổi nhân vật trong ảnh mà vẫn giữ bố cục và ánh sáng gốc.' },
	{ c: 'anh', t: 'Chỉnh sửa ảnh giữ khuôn mặt', d: 'Thay trang phục, bối cảnh, khuôn mặt vẫn y nguyên.' },
	{ c: 'anh', t: 'Multishot GPT Image', d: 'Tạo nhiều góc chụp đồng bộ từ một ảnh mẫu.' },
	{ c: 'video', t: 'Cắt video dài thành short 9:16', d: 'Tự tìm đoạn hay, cắt dọc, sẵn sàng đăng Reels và TikTok.' },
	{ c: 'video', t: '7 hiệu ứng video cao cấp', d: 'Hiệu ứng chuyển cảnh và chữ chuyển động cho video chuyên nghiệp.' },
	{ c: 'video', t: 'Edit video podcast 2 người', d: 'Tự đổi khung theo người đang nói, thêm phụ đề.' },
	{ c: 'viet', t: 'Viết content website chuẩn SEO', d: 'Bài dài, đúng cấu trúc, đúng từ khoá, đọc tự nhiên.' },
	{ c: 'viet', t: 'Humanize Content AI', d: 'Làm văn AI bớt máy móc, giống người viết thật.' },
	{ c: 'auto', t: 'Flow TVC Director', d: 'Lên kịch bản và dựng TVC bằng Google Flow theo quy trình.' },
	{ c: 'auto', t: 'SEO Agent', d: 'Agent tự nghiên cứu từ khoá, viết và tối ưu bài.' },
];

const faqs = [
	['Skill AI cài đặt có khó không?', 'Có hướng dẫn từng bước, người không biết code vẫn làm được.'],
	['Skill dùng được trên nền tảng nào?', 'Nội dung giữ chỗ.'],
	['Có cá nhân hoá Skill theo nhu cầu được không?', 'Nội dung giữ chỗ.'],
	['Thanh toán như thế nào?', 'Nội dung giữ chỗ.'],
	['Tôi có được dùng thành phẩm cho mục đích thương mại không?', 'Nội dung giữ chỗ.'],
	['Sau khi mua có được hỗ trợ không?', 'Nội dung giữ chỗ.'],
];
---

<!doctype html>
<html lang="vi">
	<head>
		<BaseHead title={`${SITE_TITLE} - ${SITE_DESCRIPTION}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="wrap">
			<div class="hero">
				<span class="pill">{SITE_DESCRIPTION}</span>
				<h1>Tìm đúng <span>công cụ AI</span> cho công việc của bạn</h1>
				<p>Những Skill AI thực chiến cho làm ảnh, viết nội dung, làm video và tự động hoá. Cài một lần, dùng mỗi ngày.</p>
				<div class="cta">
					<a class="btn btn-main" href="#skill">Xem Skill AI →</a>
					<a class="btn btn-line" href="/blog">Đọc blog</a>
				</div>
				<div class="stats">
					<div><b>{total}</b><span>Skill AI</span></div>
					<div><b>{groups.length}</b><span>Nhóm công việc</span></div>
					<div><b>Ngay</b><span>Nhận sau thanh toán</span></div>
				</div>
				<div class="hero-img">
					<img src="/images/duyen-hero.webp" width="1600" height="900" alt="Duyên Mê AI làm việc cùng laptop tại quán cà phê" fetchpriority="high" />
				</div>
			</div>

			<section>
				<h2>Thư viện Skill AI</h2>
				<p class="sub">Chọn theo việc bạn đang cần làm.</p>
				<div class="groups">
					{groups.map((g) => (
						<a class={`g ${g.cls}`} href="#skill" data-go={g.id}>
							<span class="ic">{g.icon}</span><h3>{g.name}</h3><small>{g.count} Skill</small>
						</a>
					))}
				</div>
			</section>

			<section id="skill">
				<h2>Skill nổi bật</h2>
				<div class="tabs">
					<button class="tab on" type="button" data-f="all">Tất cả</button>
					{groups.map((g) => <button class="tab" type="button" data-f={g.id}>{g.name}</button>)}
				</div>
				<div class="skills">
					{skills.map((s) => (
						<div class="sk" data-c={s.c}>
							<span class="cat">{groupName[s.c]}</span><h3>{s.t}</h3><p>{s.d}</p>
						</div>
					))}
				</div>
			</section>

			{posts.length > 0 && (
				<section>
					<div class="head"><h2>Bài viết mới</h2><a href="/blog">Xem tất cả →</a></div>
					<div class="posts">
						{posts.map((post) => (
							<a class="post" href={`/blog/${post.id}/`}>
								{post.data.heroImage && <div class="thumb"><img src={post.data.heroImage} alt="" loading="lazy" /></div>}
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<FormattedDate date={post.data.pubDate} />
							</a>
						))}
					</div>
				</section>
			)}

			<section class="about">
				<div class="about-pics">
					<img class="pic-tall" src="/images/duyen-speaker.webp" width="800" height="1427" alt="Duyên chia sẻ trên sân khấu với vai trò diễn giả" loading="lazy" />
					<img class="pic-wide" src="/images/duyen-studio.webp" width="1200" height="675" alt="Duyên cùng KOL AI duyệt ảnh trong studio" loading="lazy" />
				</div>
				<div>
					<span class="pill">Về Duyên</span>
					<h2>Mình dùng AI mỗi ngày để làm việc nhẹ hơn</h2>
					<p class="sub">Từ làm ảnh, dựng video đến viết nội dung và tự động hoá bán hàng, mọi Skill ở đây đều là quy trình mình đã chạy thật trước khi chia sẻ.</p>
					<div class="social">
						<a href="https://www.facebook.com/DuyenMeAI" target="_blank" rel="noopener">Facebook</a>
						<a href="https://www.tiktok.com/@duyenmeai" target="_blank" rel="noopener">TikTok</a>
						<a href="https://www.youtube.com/@DuyenMeAI" target="_blank" rel="noopener">YouTube</a>
					</div>
				</div>
			</section>

			<section>
				<h2>Cam kết khi mua Skill</h2>
				<div class="promise">
					<div class="pr"><b>01</b><h3>Quy trình thực chiến</h3><p>Mỗi Skill được đúc kết từ công việc thật, không phải lý thuyết.</p></div>
					<div class="pr"><b>02</b><h3>Nhận Skill ngay</h3><p>Thanh toán xong là tải về và dùng được liền.</p></div>
					<div class="pr"><b>03</b><h3>Sở hữu thành phẩm</h3><p>Ảnh, video, bài viết bạn làm ra là của bạn.</p></div>
				</div>
			</section>

			<section>
				<h2 class="center">Câu hỏi thường gặp</h2>
				<div class="faq">
					{faqs.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
				</div>
			</section>

			<section>
				<div class="final">
					<h2>Chưa biết chọn Skill nào?</h2>
					<p>Nhắn Duyên, mình tư vấn đúng Skill cho công việc của bạn.</p>
					<div class="cta"><a class="btn btn-main" href="/about">Nhắn Duyên tư vấn</a><a class="btn btn-line" href="#skill">Khám phá Skill AI</a></div>
				</div>
			</section>
		</main>
		<Footer />

		<script is:inline>
			(function () {
				function filter(f) {
					document.querySelectorAll('.tab').forEach(function (t) { t.classList.toggle('on', t.dataset.f === f); });
					document.querySelectorAll('.sk').forEach(function (s) { s.hidden = !(f === 'all' || s.dataset.c === f); });
				}
				document.querySelectorAll('.tab').forEach(function (t) { t.addEventListener('click', function () { filter(t.dataset.f); }); });
				document.querySelectorAll('[data-go]').forEach(function (g) { g.addEventListener('click', function () { filter(g.dataset.go); }); });
			})();
		</script>

		<style>
			.hero { padding: 80px 0 56px; text-align: center; }
			.hero h1 { font-size: clamp(36px, 5.4vw, 62px); line-height: 1.12; letter-spacing: -1.5px; font-weight: 800; margin: 20px auto 18px; max-width: 860px; }
			.hero h1 span { color: var(--accent); }
			.hero > p { color: var(--muted); font-size: 19px; max-width: 620px; margin: 0 auto; }
			.stats { display: flex; justify-content: center; gap: 48px; margin-top: 40px; flex-wrap: wrap; }
			.stats b { display: block; font-size: 28px; font-weight: 800; }
			.stats span { color: var(--muted); font-size: 14px; }
			.hero-img { margin-top: 48px; border-radius: 24px; overflow: hidden; aspect-ratio: 16 / 8; background: var(--soft); }
			.hero-img img { width: 100%; height: 100%; object-fit: cover; object-position: center 35%; display: block; }
			.about { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 56px; align-items: center; }
			.about h2 { margin-top: 14px; }
			.about-pics { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: 16px; align-items: end; }
			.about-pics img { width: 100%; border-radius: var(--r); display: block; object-fit: cover; }
			.pic-tall { aspect-ratio: 3 / 4.6; object-position: center 40%; }
			.pic-wide { aspect-ratio: 4 / 5; object-position: 30% center; }
			.social { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
			.social a { padding: 10px 18px; border: 1px solid var(--line); border-radius: 99px; background: var(--surface); font-weight: 600; font-size: 14.5px; }
			.social a:hover { border-color: var(--accent); color: var(--accent); }
			.groups { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 32px; }
			.g { border-radius: var(--r); padding: 26px; display: flex; flex-direction: column; gap: 6px; transition: transform 0.25s; }
			.g:hover { transform: translateY(-4px); }
			.g .ic { font-size: 28px; }
			.g h3 { font-size: 20px; font-weight: 700; margin-top: 10px; }
			.g small { color: var(--muted); font-size: 14px; }
			.g1 { background: var(--c1); } .g2 { background: var(--c2); } .g3 { background: var(--c3); } .g4 { background: var(--c4); }
			.tabs { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 28px; }
			.tab { padding: 9px 18px; border-radius: 99px; border: 1px solid var(--line); background: var(--surface); color: var(--text); font-size: 15px; font-weight: 500; cursor: pointer; }
			.tab.on, .tab:hover { background: var(--ink); color: var(--bg); border-color: var(--ink); }
			.skills { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 26px; }
			.sk { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 24px; transition: border-color 0.2s; }
			.sk:hover { border-color: var(--accent); }
			.sk[hidden] { display: none; }
			.sk .cat { font-size: 12.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.6px; color: var(--accent); }
			.sk h3 { font-size: 19px; line-height: 1.4; margin: 8px 0 6px; font-weight: 700; }
			.sk p { color: var(--muted); font-size: 15px; }
			.head { display: flex; justify-content: space-between; align-items: end; }
			.head a { color: var(--accent); font-weight: 600; font-size: 15px; }
			.promise { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 30px; }
			.pr { border-top: 3px solid var(--accent); padding-top: 20px; }
			.pr b { font-size: 34px; font-weight: 800; color: var(--accent); display: block; line-height: 1; }
			.pr h3 { font-size: 19px; margin: 12px 0 4px; }
			.pr p { color: var(--muted); font-size: 15.5px; }
			.center { text-align: center; }
			.faq { max-width: 780px; margin: 30px auto 0; }
			details { border-bottom: 1px solid var(--line); padding: 18px 0; }
			summary { cursor: pointer; font-weight: 600; font-size: 17.5px; list-style: none; display: flex; justify-content: space-between; gap: 16px; }
			summary::-webkit-details-marker { display: none; }
			summary::after { content: '+'; color: var(--accent); font-size: 22px; line-height: 1; }
			details[open] summary::after { content: '−'; }
			details p { color: var(--muted); margin-top: 10px; }
			.final { background: var(--ink); color: var(--bg); border-radius: 24px; padding: 56px; text-align: center; }
			.final p { opacity: 0.75; margin: 10px auto 0; max-width: 520px; }
			@media (max-width: 960px) { .groups, .skills { grid-template-columns: 1fr 1fr; } .about { grid-template-columns: minmax(0, 1fr); gap: 32px; } }
			@media (max-width: 620px) {
				.groups, .skills, .promise { grid-template-columns: 1fr; }
				.final { padding: 36px 22px; }
				.hero { padding-top: 48px; }
				.stats { gap: 28px; }
				.hero-img { aspect-ratio: 4 / 3; }
			}
		</style>
	</body>
</html>
